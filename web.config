<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- リクエストサイズの上限を50MBに設定 (単位: KB) -->
    <httpRuntime maxRequestLength="51200" executionTimeout="300" targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- リクエストサイズの上限を50MBに設定 (単位: Bytes) -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
